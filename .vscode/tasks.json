{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Talent Ecosystem API (localhost)",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\flask.exe",
			"args": [
				"--app",
				"talent_platform:create_app",
				"run",
				"--debug",
				"--host",
				"127.0.0.1",
				"--port",
				"5000"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}