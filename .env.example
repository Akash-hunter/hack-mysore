# Local development only. Change these values outside local development.
POSTGRES_DB=talent_ecosystem
POSTGRES_USER=talent_app
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://talent_app:local_dev_only@localhost:5432/talent_ecosystem

# Production & Deployment URLs
BACKEND_URL=https://hack-mysore.onrender.com
RENDER_EXTERNAL_URL=https://hack-mysore.onrender.com
SECRET_KEY=talent-ecosystem-dev-secret-key-change-in-prod
CORS_ALLOWED_ORIGIN=*
